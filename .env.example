# Copy or run scripts/dev-init.sh. Never commit actual credentials.
POSTGRES_PASSWORD=replace-with-random-value
POSTGRES_PORT=15432
DATABASE_URL=postgres://aiops:replace-with-random-value@127.0.0.1:15432/aiops?sslmode=disable
AIOPS_ADDR=127.0.0.1:8080
AIOPS_ADMIN_EMAIL=admin@localhost
AIOPS_ADMIN_PASSWORD=replace-with-long-random-password
OLLAMA_MODEL=qwen3.6:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:11434
# Optional providers, explicitly enabled by MODEL:
# OPENAI_MODEL=your-model
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# For DeepSeek Flash, use OPENAI_MODEL=deepseek-flash,
# OPENAI_BASE_URL=https://api.deepseek.com, and OPENAI_PROVIDER_NAME=DeepSeek.
# Keep the API key only in the local environment; do not commit it.
# OPENAI_PROVIDER_NAME=OpenAI
# OpenAI-compatible output cap: 1..4096 tokens per request.
# OPENAI_MAX_OUTPUT_TOKENS=4096
# Inference cap: 1..8 model calls per run.
# AIOPS_INFERENCE_MAX_CALLS=8
# CLAUDE_MODEL=your-model
# CLAUDE_API_KEY=
# V3 backend is activated only with an explicit instance description. A
# production deployment uses its own database and credentials, plus a separate
# instance JSON containing only the prod environment.
# AIOPS_V3_INSTANCE_CONFIG=/absolute/path/v3-instance.json
# Optional signed V3 Push sources. The JSON fixes source ID, application,
# environment and event types; token/HMAC bytes live in separate private files.
# Unset means no sources. See docs/examples/v3-push-ingress.md.
# AIOPS_V3_PUSH_SOURCES_CONFIG=/absolute/path/private/v3-push-sources.json
# Optional server-reviewed Prometheus Pull sources. The catalog binds each ID
# to one application, environment, connector, metric target and scoped query;
# the file must be private and no request may supply arbitrary PromQL.
# AIOPS_V3_PULL_SOURCES_CONFIG=/absolute/path/private/v3-pull-sources.json
# Optional V3 self-account TOTP/recovery-code service. Supply a persistent,
# server-owned 32-byte raw key file at an absolute path with mode 0600; unset
# leaves these auxiliary routes unregistered. Never put key bytes in this file.
# TOTP verification does not grant passkey approval assurance.
# AIOPS_V3_MFA_KEY_FILE=/absolute/path/private/v3-mfa-aes256.key
# Optional self-account passkey ceremonies. Requires trusted instance RP domain
# and exact HTTPS origin, matching allowed browser origin and Secure cookies at
# a TLS-terminating proxy. Proposal votes additionally require a proposal-bound
# challenge and the separate silence execution opt-in below.
# AIOPS_V3_PASSKEY_ENABLED=false
# Optional current on-call evidence for GET /me. Configure both values or
# leave both unset. The URL must be an explicitly trusted HTTPS endpoint;
# the token file is a server-owned absolute regular file with mode 0600.
# Missing or stale evidence returns an unavailable error, never a default
# inactive/on-call status. Do not place the token value in this example.
# AIOPS_V3_ONCALL_CURRENT_URL=https://oncall.example.invalid/v1/current
# AIOPS_V3_ONCALL_TOKEN_FILE=/absolute/path/private/v3-oncall.token
# Explicit V3-only opt-in for bounded, application-scoped public HTTPS Markdown
# observation and separate V3 body/revision storage. No credentials or private
# addresses. Search uses bounded keyword passages, not a vector/source-page index.
# AIOPS_V3_PUBLIC_WEB_READER_ENABLED=false
# Optional read-only GitLab Markdown source bindings. Each row fixes one HTTPS
# repository URL, project ID, branch, Markdown path and application scope.
# Requires AIOPS_VAULT_URL and AIOPS_VAULT_TOKEN at runtime. The reference is
# a Vault field locator, never a token; do not put real credentials here.
# See docs/api/v3-git-markdown-source.md for the full bounded contract.
# AIOPS_V3_GIT_MARKDOWN_BINDINGS=[{"source_url":"https://gitlab.example.invalid/group/runbooks","endpoint":"https://gitlab.example.invalid","project_id":7,"branch":"main","path_prefix":"docs","credential_ref":"vault://ops/gitlab#token","tier":"nonprod","environment_id":"dev","application_id":"app","team_id":"","connector_id":"gitlab-runbooks"}]
# Optional exact, application-scoped Confluence or Notion read-only bindings.
# Confluence fixes one numeric space_id under one HTTPS /wiki site; Notion fixes
# one page_id UUID. Supply a pre-existing Bearer token through Vault; neither
# OAuth onboarding nor token refresh is performed here. Unset installs neither
# reader. See docs/api/v3-confluence-notion-sources.md for the read limits.
# AIOPS_V3_EXTERNAL_SOURCE_BINDINGS=[{"type":"confluence","source_url":"https://docs.example.invalid/wiki","endpoint":"https://api.atlassian.com/ex/confluence/11111111-1111-4111-8111-111111111111/wiki/api/v2","space_id":"42","credential_ref":"vault://ops/confluence#token","tier":"nonprod","environment_id":"dev","application_id":"app","team_id":"","connector_id":"confluence-runbooks"},{"type":"notion","source_url":"https://www.notion.so/aaaaaaaaaaaa4aaa8aaaaaaaaaaaaaaa","endpoint":"https://api.notion.com/v1","page_id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","credential_ref":"vault://ops/notion#token","tier":"nonprod","environment_id":"dev","application_id":"app","team_id":"","connector_id":"notion-runbooks"}]
# Optional single-Docx Feishu read-only binding. A pre-existing Bearer token
# comes from Vault; the process derives its exact provider=feishu credential
# use restriction from this binding. No OAuth flow or refresh is provided.
# Endpoint is fixed to https://open.feishu.cn. See docs/api/v3-feishu-source.md.
# AIOPS_V3_FEISHU_SOURCE_BINDINGS=[{"source_url":"https://tenant.feishu.cn/docx/AAAAAAAAAAAAAAAAAAAAAAAAAAAA","endpoint":"https://open.feishu.cn","document_id":"AAAAAAAAAAAAAAAAAAAAAAAAAAAA","credential_ref":"vault://ops/feishu#token","tier":"nonprod","environment_id":"dev","application_id":"app","team_id":"","connector_id":"feishu-runbooks"}]
# Local upload knowledge sources need no binding or Vault reference. Register
# only an owned, same-environment UTF-8 text file by its server-issued
# /api/v1/uploads/{id}/content URL; see docs/api/v3-upload-source.md.
# Optional environment-bound, read-only Prometheus alert-rule source.
# AIOPS_V3_ALERT_RULES_CONFIG=/absolute/path/private/v3-alert-rules.json
# Optional, separately reviewed per-application 24-hour alert-rule trial source.
# Config and referenced credentials must be private 0600 files; see
# docs/api/v3-alert-rule-writes.md. Unset keeps mode=dry_run unavailable.
# AIOPS_V3_ALERT_RULE_TRIAL_CONFIG=/absolute/path/private/v3-alert-trial.json
# Optional, default-off rule activation through a reviewed GitOps target,
# proposal-bound Passkey quorum and an independent worker. The config and
# referenced GitLab/Argo tokens must be absolute 0600 private files; see
# docs/api/v3-alert-rule-writes.md. No automatic MR merge or Argo sync.
# AIOPS_V3_ALERT_RULE_ENABLE_CONFIG=/absolute/path/private/v3-alert-rule-enable.json
# Optional reviewed V3 Prometheus metric query catalog. Each expression must
# be independently constrained to its exact registered service/environment;
# an empty setting leaves the metric samples helper unavailable. Do not copy
# demo PromQL or place credentials in this catalog.
# AIOPS_V3_PROMETHEUS_QUERIES_CONFIG=/absolute/path/private/v3-prometheus-queries.json
# Or the PA-19 source catalog: the same queries plus reviewed Loki,
# Elasticsearch and Tempo scopes (docs/api/v3-telemetry-registry.md).
# Set only one of the two.
# AIOPS_V3_SOURCE_CATALOG=/absolute/path/private/v3-source-catalog.json
# legacy (default) or compare: compare keeps reading AIOPS_TELEMETRY_CONFIG
# and logs where the connector registry would read something else.
# AIOPS_V3_SOURCE_REGISTRY=legacy
# Seconds between Alertmanager reconciliations of firing incidents from the
# reviewed source_ids (PA-47); default 60, 0 turns it off, otherwise 15-3600.
# AIOPS_V3_ALERT_RECONCILE_SECONDS=60
# A reviewed topology_v1 query in that catalog enables complete V3 topology
# mode for this instance. It must really isolate the exact app/environment;
# unconfigured app sources then return unavailable instead of partial data.
# Optional fixed HTTPS aggregate for five complete resilience rule families.
# Configure both or neither. The token file is absolute, regular and mode 0600;
# no token bytes belong in this file or source control.
# AIOPS_V3_RESILIENCE_SOURCE_URL=https://resilience.example.invalid/v1/current
# AIOPS_V3_RESILIENCE_TOKEN_FILE=/absolute/path/private/v3-resilience.token
# Optional per-environment slash-text suggestions for GET /commands. The
# strict JSON file is an array of {environment_id,id,name,module} entries;
# module is conversation or canvas. [] is a verified empty catalog. These
# suggestions only insert text and never execute a command or tool.
# AIOPS_V3_TEXT_COMMANDS_CONFIG=/absolute/path/private/v3-text-commands.json
# Optional read-only Alertmanager source. Every returned silence or inhibition
# rule must contain exact environment matchers; broad records are omitted.
# When silence execution is enabled, this same file must be an absolute regular
# 0600 private file; every configured endpoint must be HTTPS with allow_http
# disabled, an absolute regular 0600 nonempty token file, and verified
# source IDs plus active application/environment bindings. Credentials stay out
# of this example. The default below does not allow any upstream write.
# AIOPS_V3_ALERTMANAGER_CONFIG=/absolute/path/private/v3-alertmanager.json
# AIOPS_V3_SILENCE_EXECUTION_ENABLED=false
# Optional bulk alert-group silence. This is considered only when the silence
# execution switch above is true. The private 0600 JSON file must contain
# reviewed env/source/application bindings, a dedicated upstream group label,
# attestation digest/revision/expiry and the exact current Alertmanager binding
# fingerprint. Missing configuration leaves bulk silence disconnected.
# AIOPS_V3_BULK_GROUP_SILENCE_CONFIG=/absolute/path/private/v3-bulk-group-silence.json
# Optional operator-reviewed complete alert coverage per application and
# environment for V3 service catalog/detail. It must match an active Operations
# Alertmanager source and exact label mapping; missing coverage returns 503.
# See docs/examples/v3-service-alert-coverage.md.
# AIOPS_V3_SERVICE_ALERT_COVERAGE_CONFIG=/absolute/path/private/v3-service-alert-coverage.json
# AIOPS_V3_LOWER_SOURCES_CONFIG=/absolute/path/private/v3-lower-sources.json
# Comma-separated model IDs (for example openai:your-model) whose function
# calling has been verified with that provider. Unset means no V3 AI read tools.
# AIOPS_V3_TOOL_MODELS=
# AIOPS_VAULT_URL=https://vault.example.invalid
# AIOPS_VAULT_TOKEN=read-from-secret-manager-not-this-file
# V3 connector Vault use requires a private, server-managed exact binding for
# each tier/environment/connector ID/provider/endpoint/reference. Empty denies
# credential reads. See docs/api/v3-connector-credentials.md.
# AIOPS_V3_CONNECTOR_CREDENTIAL_BINDINGS=[{"tier":"nonprod","environment_id":"dev","connector_id":"generated-connector-id","provider":"prometheus","endpoint":"https://metrics.example.invalid","credential_ref":"vault://mount/path#field"}]
# PA-08 Kubernetes rollback: the Deployments the independent executor may roll
# back, with a write token only the executor reads (Vault only, never a
# connector credential). Without it rollback proposals cannot be approved.
# See docs/api/v3-telemetry-registry.md and docs/api/v3-rollback.md.
# AIOPS_V3_KUBERNETES_WRITE_BINDINGS=[{"tier":"nonprod","environment":"dev","connector_id":"generated-connector-id","namespace":"example","deployments":["example-api"],"actions":["deployment.rollback"],"credential_ref":"vault://mount/path#field"}]
# AIOPS_CONNECTOR_CONFIG=/absolute/path/.local/aiops-canvas-demo/connector.json

# Optional read-only telemetry registrations (see docs/demo.md and docs/api/v3-logs-source.md):
# AIOPS_TELEMETRY_CONFIG=/absolute/path/telemetry.json

# Optional built Web workspace. Leave commented to preserve a value passed to make run.
# Example: AIOPS_WEB_DIR="$PWD/web/dist" make run
# AIOPS_WEB_DIR=/absolute/path/to/aiops/web/dist
# Production origin and cookies; make web-api overrides origin/address for Vite.
# AIOPS_PUBLIC_ORIGIN=https://your-domain.example
# AIOPS_SECURE_COOKIES=true
# Optional member invitations. Set all five values together with the HTTPS
# AIOPS_PUBLIC_ORIGIN above and secure cookies. SMTP uses certificate-checked
# implicit TLS on port 465. The password file is absolute, regular, mode 0600;
# never put its contents in this example or source control. The product entry
# must use this instance's exact trusted origin; it does not contain a code.
# AIOPS_V3_INVITATION_SMTP_HOST=mail.example.invalid
# AIOPS_V3_INVITATION_SMTP_FROM=aiops@example.invalid
# AIOPS_V3_INVITATION_SMTP_USERNAME=aiops@example.invalid
# AIOPS_V3_INVITATION_SMTP_PASSWORD_FILE=/absolute/path/private/v3-smtp-password
# AIOPS_V3_INVITATION_ENTRY_URL=https://your-domain.example/

# Optional V3 OIDC sign-in. Configure a public-origin callback in the IdP;
# only explicitly bind an existing enabled human member to the exact IdP
# subject through the platform-admin OIDC binding API. Never map by email.
# AIOPS_V3_OIDC_ISSUER=https://idp.example/realms/aiops
# AIOPS_V3_OIDC_CLIENT_ID=aiops-canvas
# AIOPS_V3_OIDC_CLIENT_SECRET=load-from-private-runtime-secret
# AIOPS_V3_OIDC_REDIRECT_URL=https://your-domain.example/api/v1/auth/oidc/callback
# Optional comma-separated HTTPS origins for trusted IdP token/JWKS hosts.
# AIOPS_V3_OIDC_ENDPOINT_ORIGINS=https://idp-static.example
# Local isolated Keycloak only: AIOPS_V3_OIDC_ALLOW_LOOPBACK_HTTP=true

# Multi-application registrations and alerts (credentials remain in private files):
# AIOPS_KUBERNETES_REGISTRY=/absolute/path/kubernetes-registry.json
# AIOPS_OPERATIONS_CONFIG=/absolute/path/operations.json
# See docs/platform-contract.md and docs/operations-contract.md.
# Per-provider context budgets, applied to the next inference run:
# OLLAMA_CONTEXT_WINDOW=32768
# OLLAMA_INPUT_BUDGET=28672
# OPENAI_CONTEXT_WINDOW=32768
# OPENAI_INPUT_BUDGET=28672
# CLAUDE_CONTEXT_WINDOW=32768
# CLAUDE_INPUT_BUDGET=28672

# Optional delivery modules. JSON files reference private credential files.
# See docs/delivery-workspace.md; empty configuration disables external engines.
# AIOPS_DELIVERY_CONFIG=/absolute/path/private/delivery.json
# AIOPS_DEPLOYMENT_CONFIG=/absolute/path/private/deployment.json
# MCP Bearer token directory (0700); files must be 0600. Never put values in source.
# AIOPS_MCP_CREDENTIAL_ROOT=/absolute/path/private/mcp-credentials

# Optional read-only Kubernetes/host inventory sync; see docs/resource-sync.md.
# AIOPS_INVENTORY_CONFIG=/absolute/path/private/inventory.json
