# Copy or run scripts/dev-init.sh. Never commit actual credentials.
POSTGRES_PASSWORD=replace-with-random-value
POSTGRES_PORT=15432
DATABASE_URL=postgres://aiops:replace-with-random-value@127.0.0.1:15432/aiops?sslmode=disable
AIOPS_ADDR=127.0.0.1:8080
AIOPS_ADMIN_EMAIL=admin@localhost
AIOPS_ADMIN_PASSWORD=replace-with-long-random-password
OLLAMA_MODEL=qwen3.6:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:11434
# Optional providers, explicitly enabled by MODEL:
# OPENAI_MODEL=your-model
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# For DeepSeek Flash, use OPENAI_MODEL=deepseek-flash,
# OPENAI_BASE_URL=https://api.deepseek.com, and OPENAI_PROVIDER_NAME=DeepSeek.
# Keep the API key only in the local environment; do not commit it.
# OPENAI_PROVIDER_NAME=OpenAI
# OpenAI-compatible output cap: 1..4096 tokens per request.
# OPENAI_MAX_OUTPUT_TOKENS=4096
# Inference cap: 1..8 model calls per run.
# AIOPS_INFERENCE_MAX_CALLS=8
# CLAUDE_MODEL=your-model
# CLAUDE_API_KEY=
# V3 backend is activated only with an explicit instance description. A
# production deployment uses its own database and credentials, plus a separate
# instance JSON containing only the prod environment.
# AIOPS_V3_INSTANCE_CONFIG=/absolute/path/v3-instance.json
# Optional V3 self-account TOTP/recovery-code service. Supply a persistent,
# server-owned 32-byte raw key file at an absolute path with mode 0600; unset
# leaves these auxiliary routes unregistered. Never put key bytes in this file.
# TOTP verification does not grant passkey approval assurance.
# AIOPS_V3_MFA_KEY_FILE=/absolute/path/private/v3-mfa-aes256.key
# Optional self-account passkey ceremonies. Requires trusted instance RP domain
# and exact HTTPS origin, matching allowed browser origin and Secure cookies at
# a TLS-terminating proxy. Does not enable proposal approval assurance.
# AIOPS_V3_PASSKEY_ENABLED=false
# Explicit V3-only opt-in for bounded, application-scoped public HTTPS Markdown
# observation and separate V3 body/revision storage. No credentials or private
# addresses. Search uses bounded keyword passages, not a vector/source-page index.
# AIOPS_V3_PUBLIC_WEB_READER_ENABLED=false
# Optional environment-bound, read-only Prometheus alert-rule source.
# AIOPS_V3_ALERT_RULES_CONFIG=/absolute/path/private/v3-alert-rules.json
# Optional reviewed V3 Prometheus metric query catalog. Each expression must
# be independently constrained to its exact registered service/environment;
# an empty setting leaves the metric samples helper unavailable. Do not copy
# demo PromQL or place credentials in this catalog.
# AIOPS_V3_PROMETHEUS_QUERIES_CONFIG=/absolute/path/private/v3-prometheus-queries.json
# Optional read-only Alertmanager source. Every returned silence or inhibition
# rule must contain exact environment matchers; broad records are omitted.
# AIOPS_V3_ALERTMANAGER_CONFIG=/absolute/path/private/v3-alertmanager.json
# AIOPS_V3_LOWER_SOURCES_CONFIG=/absolute/path/private/v3-lower-sources.json
# Comma-separated model IDs (for example openai:your-model) whose function
# calling has been verified with that provider. Unset means no V3 AI read tools.
# AIOPS_V3_TOOL_MODELS=
# AIOPS_VAULT_URL=https://vault.example.invalid
# AIOPS_VAULT_TOKEN=read-from-secret-manager-not-this-file
# V3 connector Vault use requires a private, server-managed exact binding for
# each tier/environment/connector ID/provider/endpoint/reference. Empty denies
# credential reads. See docs/api/v3-connector-credentials.md.
# AIOPS_V3_CONNECTOR_CREDENTIAL_BINDINGS=[{"tier":"nonprod","environment_id":"dev","connector_id":"generated-connector-id","provider":"prometheus","endpoint":"https://metrics.example.invalid","credential_ref":"vault://mount/path#field"}]
# AIOPS_CONNECTOR_CONFIG=/absolute/path/.local/aiops-canvas-demo/connector.json

# Optional read-only Prometheus/Loki registrations (see docs/demo.md):
# AIOPS_TELEMETRY_CONFIG=/absolute/path/telemetry.json

# Optional built Web workspace. Leave commented to preserve a value passed to make run.
# Example: AIOPS_WEB_DIR="$PWD/web/dist" make run
# AIOPS_WEB_DIR=/absolute/path/to/aiops/web/dist
# Production origin and cookies; make web-api overrides origin/address for Vite.
# AIOPS_PUBLIC_ORIGIN=https://your-domain.example
# AIOPS_SECURE_COOKIES=true

# Optional V3 OIDC sign-in. Configure a public-origin callback in the IdP;
# only explicitly bind an existing enabled human member to the exact IdP
# subject through the platform-admin OIDC binding API. Never map by email.
# AIOPS_V3_OIDC_ISSUER=https://idp.example/realms/aiops
# AIOPS_V3_OIDC_CLIENT_ID=aiops-canvas
# AIOPS_V3_OIDC_CLIENT_SECRET=load-from-private-runtime-secret
# AIOPS_V3_OIDC_REDIRECT_URL=https://your-domain.example/api/v1/auth/oidc/callback
# Optional comma-separated HTTPS origins for trusted IdP token/JWKS hosts.
# AIOPS_V3_OIDC_ENDPOINT_ORIGINS=https://idp-static.example
# Local isolated Keycloak only: AIOPS_V3_OIDC_ALLOW_LOOPBACK_HTTP=true

# Multi-application registrations and alerts (credentials remain in private files):
# AIOPS_KUBERNETES_REGISTRY=/absolute/path/kubernetes-registry.json
# AIOPS_OPERATIONS_CONFIG=/absolute/path/operations.json
# See docs/platform-contract.md and docs/operations-contract.md.
# Per-provider context budgets, applied to the next inference run:
# OLLAMA_CONTEXT_WINDOW=32768
# OLLAMA_INPUT_BUDGET=28672
# OPENAI_CONTEXT_WINDOW=32768
# OPENAI_INPUT_BUDGET=28672
# CLAUDE_CONTEXT_WINDOW=32768
# CLAUDE_INPUT_BUDGET=28672

# Optional delivery modules. JSON files reference private credential files.
# See docs/delivery-workspace.md; empty configuration disables external engines.
# AIOPS_DELIVERY_CONFIG=/absolute/path/private/delivery.json
# AIOPS_DEPLOYMENT_CONFIG=/absolute/path/private/deployment.json
# MCP Bearer token directory (0700); files must be 0600. Never put values in source.
# AIOPS_MCP_CREDENTIAL_ROOT=/absolute/path/private/mcp-credentials

# Optional read-only Kubernetes/host inventory sync; see docs/resource-sync.md.
# AIOPS_INVENTORY_CONFIG=/absolute/path/private/inventory.json
