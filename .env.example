# Copy or run scripts/dev-init.sh. Never commit actual credentials.
POSTGRES_PASSWORD=replace-with-random-value
POSTGRES_PORT=15432
DATABASE_URL=postgres://aiops:replace-with-random-value@127.0.0.1:15432/aiops?sslmode=disable
AIOPS_ADDR=127.0.0.1:8080
AIOPS_ADMIN_EMAIL=admin@localhost
AIOPS_ADMIN_PASSWORD=replace-with-long-random-password
OLLAMA_MODEL=qwen3.6:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:11434
# Optional providers, explicitly enabled by MODEL:
# OPENAI_MODEL=your-model
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# CLAUDE_MODEL=your-model
# CLAUDE_API_KEY=
# AIOPS_CONNECTOR_CONFIG=/absolute/path/.local/aiops-canvas-demo/connector.json

# Optional read-only Prometheus/Loki registrations (see docs/demo.md):
# AIOPS_TELEMETRY_CONFIG=/absolute/path/telemetry.json
